    {
        "id": "17265325db865eb6",
        "type": "function",
        "z": "f86ca75c5d5c171b",
        "g": "5ccebdebceea4467",
        "name": "Get logs",
        "func": "// Lấy nhật ký thao tác ở thời điểm hiện tại\n// Nếu chưa có thao tác gì, tạo mảng rỗng\nvar logs = flow.get('logs') || [];\n\n// Lấy thông tin thao tác mới\nvar newLog = {\n    topic: msg.topic,\n    payload: msg.payload\n   \n};\n\n// Thêm thông tin thao tác mới vào nhật kí thao tác \nlogs.push(newLog);\n\n// Lưu nhật ký thao tấc mới vào 'logs'\nflow.set('logs', logs);\n\nmsg.payload = logs;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
