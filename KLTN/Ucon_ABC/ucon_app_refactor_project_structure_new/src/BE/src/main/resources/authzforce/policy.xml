<?xml version='1.0' encoding='UTF-8'?>
<PolicySet xmlns="urn:oasis:names:tc:xacml:3.0:core:schema:wd-17" PolicySetId="ebook_read_policy_set" Version="1.0" PolicyCombiningAlgId="urn:oasis:names:tc:xacml:1.0:policy-combining-algorithm:first-applicable">
    <Target/>
    <Policy PolicyId="rental_read_pre_policy" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">READ</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="urn:ucon:attr:action:id" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">BOOK_VOLUME</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:resource:type" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">RENTAL</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:access:path" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PRE</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:phase" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>
        <!-- =====================================================
             RULE 1 - Kiểm tra preA và preC trước.

             Nếu chỉ cần một điều kiện nền không thỏa thì yêu cầu bị
             từ chối ngay, không trả Advice yêu cầu thực hiện preB.
             ===================================================== -->
        <Rule RuleId="deny-rental-read-when-a-or-c-fails" Effect="Deny">
            <Condition>
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                        <!-- preA: users.status = ACTIVE -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject" AttributeId="urn:ucon:attr:users:status" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ACTIVE</AttributeValue>
                        </Apply>
                        <!-- preA: books.status = ACTIVE -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:books:status" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ACTIVE</AttributeValue>
                        </Apply>
                        <!-- preA: book_volumes.status = ACTIVE -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:book_volumes:status" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ACTIVE</AttributeValue>
                        </Apply>
                        <!-- preA: book_volumes.access_model_override = RENTAL -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:book_volumes:access_model_override" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">RENTAL</AttributeValue>
                        </Apply>
                        <!-- preA: user_rentals.status = ACTIVE -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:user_rentals:status" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ACTIVE</AttributeValue>
                        </Apply>
                        <!-- preC: user_rentals.expires_at > environment.current_time -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:dateTime-greater-than">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:dateTime-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:user_rentals:expires_at" DataType="http://www.w3.org/2001/XMLSchema#dateTime" MustBePresent="true"/>
                            </Apply>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:dateTime-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:environment:current_time" DataType="http://www.w3.org/2001/XMLSchema#dateTime" MustBePresent="true"/>
                            </Apply>
                        </Apply>
                    </Apply>
                </Apply>
            </Condition>
        </Rule>
        <!-- =====================================================
             RULE 2 - Kiểm tra preB sau khi preA và preC đã thỏa.

             Do first-applicable chỉ đi đến Rule này khi Rule 1
             NotApplicable, không cần lặp lại điều kiện A và C.
             ===================================================== -->
        <Rule RuleId="deny-rental-read-when-pre-obligation-is-missing" Effect="Deny">
            <Condition>
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                        <!-- preB: Evidence status = FULFILLED -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:ucon:category:obligation" AttributeId="urn:ucon:attr:obligation:EBOOK_TERMS_V1:status" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">FULFILLED</AttributeValue>
                        </Apply>
                        <!-- preB: Evidence version = 1.0 -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:ucon:category:obligation" AttributeId="urn:ucon:attr:obligation:EBOOK_TERMS_V1:version" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">1.0</AttributeValue>
                        </Apply>
                    </Apply>
                </Apply>
            </Condition>
            <AdviceExpressions>
                <AdviceExpression AdviceId="urn:ucon:advice:missing-pre-obligation" AppliesTo="Deny">
                    <AttributeAssignmentExpression AttributeId="urn:ucon:obligation:id">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">EBOOK_TERMS_V1</AttributeValue>
                    </AttributeAssignmentExpression>
                    <AttributeAssignmentExpression AttributeId="urn:ucon:obligation:type">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">CONSENT</AttributeValue>
                    </AttributeAssignmentExpression>
                    <AttributeAssignmentExpression AttributeId="urn:ucon:obligation:version">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">1.0</AttributeValue>
                    </AttributeAssignmentExpression>
                    <AttributeAssignmentExpression AttributeId="urn:ucon:obligation:policy-ref">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">rental_read_pre_policy</AttributeValue>
                    </AttributeAssignmentExpression>
                </AdviceExpression>
            </AdviceExpressions>
        </Rule>
        <!-- =====================================================
             RULE 3 - Permit mặc định.

             PDP chỉ đi đến Rule này khi:
             - Rule 1 NotApplicable: preA và preC đã thỏa;
             - Rule 2 NotApplicable: preB đã thỏa.
             ===================================================== -->
        <Rule RuleId="permit-rental-read-pre" Effect="Permit"/>
    </Policy>
    
    <Policy PolicyId="rental_read_ongoing_policy" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">READ</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="urn:ucon:attr:action:id" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">BOOK_VOLUME</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:resource:type" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">RENTAL</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:access:path" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ONGOING</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:phase" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>
        <!--
             RULE 1 - Từ chối khi điều kiện ongoing không còn thỏa.

             Nếu trạng thái lượt thuê không còn ACTIVE hoặc đã hết hạn,
             phiên sử dụng không được tiếp tục.
             -->
        <Rule RuleId="deny-rental-read-ongoing-when-condition-fails" Effect="Deny">
            <Condition>
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                        <!-- user_rentals.status = ACTIVE -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:user_rentals:status" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ACTIVE</AttributeValue>
                        </Apply>
                        <!-- user_rentals.expires_at > environment.current_time -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:dateTime-greater-than">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:dateTime-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:user_rentals:expires_at" DataType="http://www.w3.org/2001/XMLSchema#dateTime" MustBePresent="true"/>
                            </Apply>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:dateTime-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:environment:current_time" DataType="http://www.w3.org/2001/XMLSchema#dateTime" MustBePresent="true"/>
                            </Apply>
                        </Apply>
                    </Apply>
                </Apply>
            </Condition>
        </Rule>
        <!--
             RULE 2 - Permit khi điều kiện ongoing vẫn thỏa.

             PDP chỉ đi đến Rule này khi Rule 1 NotApplicable.
             -->
        <Rule RuleId="permit-rental-read-ongoing" Effect="Permit"/>
    </Policy>
    
    <Policy PolicyId="rental_read_post_policy" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">READ</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="urn:ucon:attr:action:id" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">BOOK_VOLUME</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:resource:type" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">RENTAL</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:access:path" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">POST</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:phase" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>
        <!--
             POST không có điều kiện A/B/C cần kiểm tra.
             Rule Permit này trả chỉ dẫn cập nhật thuộc tính khi policy Target khớp.
             XACML ObligationExpression chỉ được dùng làm vùng chứa PEP action;
             chỉ dẫn này không được xử lý bởi ObligationManager của UCON.
             -->
        <Rule RuleId="permit-rental-read-post" Effect="Permit">
            <ObligationExpressions>
                <ObligationExpression ObligationId="urn:ucon:instruction:attribute-update" FulfillOn="Permit">
                    <AttributeAssignmentExpression AttributeId="urn:ucon:instruction:attribute-update:action-code">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">INCREASE_BOOK_VOLUME_READ_COUNT</AttributeValue>
                    </AttributeAssignmentExpression>
                </ObligationExpression>
            </ObligationExpressions>
        </Rule>
    </Policy>
    
    <!-- =========================================================
         PRE policy
         allowed(s, o, read) =
             users.status = ACTIVE
             AND books.status = ACTIVE
             AND book_volumes.status = ACTIVE
             AND family_share_active(s, o) = true
         ========================================================= -->
    <Policy PolicyId="family_shared_read_pre_policy" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">READ</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="urn:ucon:attr:action:id" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">BOOK_VOLUME</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:resource:type" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">FAMILY_SHARED</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:access:path" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PRE</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:phase" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>
        <!--
             RULE 1 - Từ chối khi điều kiện preA của FAMILY_SHARED không thỏa.

             Policy này chưa có preB, vì vậy sau khi các điều kiện
             authorization thỏa thì có thể Permit trực tiếp.
             -->
        <Rule RuleId="deny-family-shared-read-pre-when-authorization-fails" Effect="Deny">
            <Condition>
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                        <!-- users.status = ACTIVE -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject" AttributeId="urn:ucon:attr:users:status" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ACTIVE</AttributeValue>
                        </Apply>
                        <!-- books.status = ACTIVE -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:books:status" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ACTIVE</AttributeValue>
                        </Apply>
                        <!-- book_volumes.status = ACTIVE -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:book_volumes:status" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ACTIVE</AttributeValue>
                        </Apply>
                        <!-- family_share_active(s, o) = true -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-equal">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject" AttributeId="urn:ucon:attr:family_share_active" DataType="http://www.w3.org/2001/XMLSchema#boolean" MustBePresent="true"/>
                            </Apply>
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#boolean">true</AttributeValue>
                        </Apply>
                    </Apply>
                </Apply>
            </Condition>
        </Rule>
        <!--
             RULE 2 - Permit khi toàn bộ điều kiện preA đã thỏa.
             -->
        <Rule RuleId="permit-family-shared-read-pre" Effect="Permit"/>
    </Policy>
    
    <!-- =========================================================
         ONGOING policy
         !stopped(s, o, read) = family_share_active(s, o)
         ========================================================= -->
    <Policy PolicyId="family_shared_read_ongoing_policy" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">READ</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="urn:ucon:attr:action:id" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">BOOK_VOLUME</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:resource:type" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">FAMILY_SHARED</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:access:path" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ONGOING</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:phase" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>
        <!--
             RULE 1 - Từ chối khi quan hệ chia sẻ gia đình không còn hợp lệ.
             -->
        <Rule RuleId="deny-family-shared-read-ongoing-when-condition-fails" Effect="Deny">
            <Condition>
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-equal">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject" AttributeId="urn:ucon:attr:family_share_active" DataType="http://www.w3.org/2001/XMLSchema#boolean" MustBePresent="true"/>
                        </Apply>
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#boolean">true</AttributeValue>
                    </Apply>
                </Apply>
            </Condition>
        </Rule>
        <!--
             RULE 2 - Permit khi family_share_active vẫn bằng true.
             -->
        <Rule RuleId="permit-family-shared-read-ongoing" Effect="Permit"/>
    </Policy>
    
    <!-- =========================================================
         POST policy
         Chính sách family share cũng tăng read_count
         khi người dùng kết thúc phiên đọc bình thường.
         ========================================================= -->
    <Policy PolicyId="family_shared_read_post_policy" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">READ</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="urn:ucon:attr:action:id" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">BOOK_VOLUME</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:resource:type" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">FAMILY_SHARED</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="urn:ucon:attr:access:path" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">POST</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" AttributeId="urn:ucon:attr:phase" DataType="http://www.w3.org/2001/XMLSchema#string" MustBePresent="true"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>
        <!--
             POST không có điều kiện A/B/C cần kiểm tra.
             Rule Permit này trả chỉ dẫn cập nhật thuộc tính khi policy Target khớp.
             XACML ObligationExpression chỉ được dùng làm vùng chứa PEP action;
             chỉ dẫn này không được xử lý bởi ObligationManager của UCON.
             -->
        <Rule RuleId="permit-family-shared-read-post" Effect="Permit">
            <ObligationExpressions>
                <ObligationExpression ObligationId="urn:ucon:instruction:attribute-update" FulfillOn="Permit">
                    <AttributeAssignmentExpression AttributeId="urn:ucon:instruction:attribute-update:action-code">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">INCREASE_BOOK_VOLUME_READ_COUNT</AttributeValue>
                    </AttributeAssignmentExpression>
                </ObligationExpression>
            </ObligationExpressions>
        </Rule>
    </Policy>
</PolicySet>